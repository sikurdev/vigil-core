# PostgreSQL connection string (app + worker + pg-boss job queue)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vigil

# Secret for session/token signing — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical origin of the app
APP_URL=http://localhost:3000

# Optional: enables AI postmortem drafts and incident summaries
# ANTHROPIC_API_KEY=

# Optional: enables real email notifications via Resend (log transport otherwise)
# RESEND_API_KEY=
# EMAIL_FROM=Vigil <onboarding@resend.dev>

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Allow monitors to target private/loopback addresses (dev only — SSRF risk)
ALLOW_PRIVATE_MONITOR_TARGETS=false
# RDAP endpoint for `domain-expiry` monitors. The default is the
# IANA-backed bootstrap redirector, which forwards to the registry
# authoritative for each TLD. Point it at a mirror, or at a registry
# directly in an air-gapped install.
RDAP_BASE_URL=https://rdap.org


# Read-only public demo: disables sign-up and all mutations,
# enables one-click viewer login at /api/demo (see docs/DEMO.md)
DEMO_MODE=false
