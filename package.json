    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "pg-boss": "^12.24.1",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
