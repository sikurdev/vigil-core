# Production environment template for Vigil.
# Copy to your secret manager / host env — do not commit real values.

# --- Required -------------------------------------------------------------

# Postgres 18+; the app, worker and job queue share this database.
DATABASE_URL=postgresql://vigil:CHANGE_ME@db.internal:5432/vigil

# Session/token signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_MINIMUM

# Canonical public origin (links in emails, CORS trust, status pages)
APP_URL=https://vigil.yourdomain.com

# --- Optional -------------------------------------------------------------

# Enables AI postmortem drafts + status-update suggestions
# ANTHROPIC_API_KEY=sk-ant-...

# Enables real email notifications via Resend. Without a key, notifications
# are written to the logs. EMAIL_FROM must be a domain Resend verifies.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Vigil <alerts@yourdomain.com>

# fatal | error | warn | info | debug | trace   (default: info)
LOG_LEVEL=info

# --- Egress, per channel (see SECURITY.md) ---------------------------------

# Leave false in production: monitors may not probe private networks (SSRF)
ALLOW_PRIVATE_MONITOR_TARGETS=false
# These two default to TRUE: a self-hosted install routinely posts to a
# receiver on its own network, and a restart hook on an internal address is
# the point of the recovery feature. Set false where those URLs are not
# typed by someone you trust. The never-reachable floor (cloud metadata,
# link-local, reserved space) is refused on every channel regardless.
# ALLOW_PRIVATE_WEBHOOK_TARGETS=true
# ALLOW_PRIVATE_RECOVERY_TARGETS=true

# RDAP endpoint for `domain-expiry` monitors. The default is the
# IANA-backed bootstrap redirector, which forwards to the registry
# authoritative for each TLD. Point it at a mirror, or at a registry
# directly in an air-gapped install.
RDAP_BASE_URL=https://rdap.org

# A browserless-compatible renderer for `real-browser` monitors. Vigil ships
# no browser. Without this they report `misconfigured` rather than down.
# BROWSER_SERVICE_URL=http://browserless:3000

# --- Scripted synthetics (commercial; see docs/SYNTHETICS.md §8) ------------

# Only needed for `synthetic-browser` journeys. API journeys run in the
# worker and need nothing here. The worker and the runner must present the
# same token, and the runner refuses to start beyond loopback without one.
# SYNTHETICS_RUNNER_URL=http://vigil-synthetics:3100
# SYNTHETICS_RUNNER_TOKEN=CHANGE_ME
# Journeys this worker runs at once (1-32). Default 2, and the number is the
# point: a browser journey holds its slot for as long as a customer takes to
# click through, and sizing it wrong starves the ordinary checks.
# SYNTHETIC_CONCURRENCY=2
# Backpressure, not a cap on how many synthetic monitors you may have (default
# 200). Past this depth the tick leaves them due rather than piling up.
# SYNTHETIC_QUEUE_MAX_DEPTH=200

# --- Worker tuning ---------------------------------------------------------

# This replica's ledger identity; defaults to the hostname. Give each worker
# a distinct value — sharing one means sharing a hash chain and contending on
# its sequence.
# VIGIL_ACTOR_NAME=vigil-worker-1

# How many due monitors one scheduler tick may enqueue (1-50,000, default
# 5,000). Suits fleets far larger than most installations run.
# MONITOR_SCHEDULER_BATCH=5000

# Notification drain: work one tick may consider (default 250), attempts
# before a delivery is given up (default 20), the retry horizon in hours
# (default 6), and how long finished deliveries and their attempt evidence
# are kept in days (default 30). Delivery concurrency defaults to a bound
# derived from the pg pool.
# NOTIFICATION_BATCH_SIZE=250
# NOTIFICATION_MAX_ATTEMPTS=20
# NOTIFICATION_RETRY_HORIZON_HOURS=6
# NOTIFICATION_RETENTION_DAYS=30
# NOTIFICATION_DELIVERY_CONCURRENCY=

# When a monitor opens an incident, Vigil fires at most four read-only
# probes at that target - resolve, connect, handshake, request - and
# stores what they saw as the incident's evidence. They change nothing:
# not the monitor's health, not the incident, not paging, not a status
# page. Set false if your targets cannot accept unscheduled requests; the
# rest of the evidence is still captured and the failing layer is
# reported as unknown rather than guessed. See docs/INCIDENT-EVIDENCE.md.
# INCIDENT_EVIDENCE_BURST=true

# Remote-probe evidence retention in days: raw results (default 14) and
# decided rounds (default 90). Commercial; see docs/REMOTE-PROBES.md.
# PROBE_RAW_RETENTION_DAYS=14
# PROBE_EVIDENCE_RETENTION_DAYS=90

# Per-replica detail on the worker fleet page. Off by default.
# VIGIL_FLEET_DETAIL=false

# Public read-only demo deployment only — see docs/DEMO.md
DEMO_MODE=false
